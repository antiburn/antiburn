+#[test]
+fn capture_main_64_file_receipts() {
+    let output = std::path::PathBuf::from(std::env::var("ANTIBURN_RECEIPT_FIXTURE_OUTPUT").unwrap());
+    for agent in ["claude", "codex", "pi"] {
+        let directory = TempDir::new().unwrap();
+        let (header, suffix, session, format) = ongoing_source(agent, 2);
+        let lines = suffix.split_inclusive('\n').collect::<Vec<_>>();
+        let split = lines[3].len() / 2;
+        let prefix = format!("{}{}", lines[..3].concat(), &lines[3][..split]);
+        let input = input(&directory, agent, session, format, &header);
+        let initial = read_native_file_page(&input, None, &|| false).unwrap();
+        append(&input, &prefix);
+        let page = read_native_file_page(&input, Some(&initial.cursor), &|| false).unwrap();
+        assert_eq!(page.results.len(), 1);
+        assert!(page.pending_tail);
+        let mut fixture = serde_json::json!({
+            "parser_revision":64,"source_prefix":format!("{header}{prefix}"),
+            "source_suffix":&lines[3][split..],"cursor":page.cursor,
+            "completed":page.results.iter().map(|result| &result.observation).collect::<Vec<_>>()
+        });
+        fixture["cursor_sha256"] = serde_json::json!(fixture_digest(&fixture["cursor"]));
+        sparse_fixture(&mut fixture["cursor"]);
+        std::fs::write(output.join(format!("file-{agent}.json")), serde_json::to_vec_pretty(&fixture).unwrap()).unwrap();
+    }
+    let directory = TempDir::new().unwrap();
+    let (header, suffix, session, format) = ongoing_source("claude", 1);
+    let lines = suffix.lines().collect::<Vec<_>>();
+    let mut call: Value = serde_json::from_str(lines[0]).unwrap();
+    let mut result: Value = serde_json::from_str(lines[1]).unwrap();
+    call["uuid"] = serde_json::json!("queued-call-row");
+    call["parentUuid"] = serde_json::json!("result-0");
+    result["uuid"] = serde_json::json!("queued-result-row");
+    result["parentUuid"] = serde_json::json!("queued-call-row");
+    call["message"]["content"] = serde_json::json!((0..256).map(|index| serde_json::json!({
+        "type":"tool_use","id":format!("queued-{index}"),"name":"Bash","input":{"command":"synthetic"}
+    })).collect::<Vec<_>>());
+    result["message"]["content"] = serde_json::json!((0..256).map(|index| serde_json::json!({
+        "type":"tool_result","tool_use_id":format!("queued-{index}"),"content":"ok","is_error":false
+    })).collect::<Vec<_>>());
+    let source = format!("{header}{suffix}{call}\n{result}\n");
+    let input = input(&directory, "claude", session, format, &header);
+    let initial = read_native_file_page(&input, None, &|| false).unwrap();
+    append(&input, &format!("{suffix}{call}\n{result}\n"));
+    let page = read_native_file_page(&input, Some(&initial.cursor), &|| false).unwrap();
+    assert!(page.cursor.pending_results.is_some());
+    assert_eq!(page.results.len(), 256);
+    let mut fixture = serde_json::json!({"parser_revision":64,"source_prefix":source,
+        "source_suffix":"","cursor":page.cursor,"completed_count":page.results.len()});
+    fixture["cursor_sha256"] = serde_json::json!(fixture_digest(&fixture["cursor"]));
+    sparse_fixture(&mut fixture["cursor"]);
+    std::fs::write(output.join("file-claude-pending.json"), serde_json::to_vec_pretty(&fixture).unwrap()).unwrap();
+}
