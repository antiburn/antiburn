+#[test]
+fn capture_main_64_journal_eviction_receipt() {
+    use antiburn_local::analysis::read_opencode_live_tool_result_page;
+    let (_directory, path) = create_database();
+    let connection = Connection::open(&path).unwrap();
+    delivery_journal(&connection, 16);
+    let request_text = |index| json!({"sessionID":"root","part":{
+        "id":"request-text","messageID":"request","type":"text",
+        "text":format!("synthetic request {index}")}});
+    for index in 0..17 {
+        insert_journal_event(&connection, 4 + index * 2, "message.part.updated.1", request_text(index));
+        insert_journal_event(&connection, 5 + index * 2, "message.part.updated.1", delivery_result(index as usize));
+    }
+    let mut pending = delivery_result(17);
+    pending["part"]["state"]["status"] = json!("running");
+    insert_journal_event(&connection, 38, "message.part.updated.1", pending);
+    let page = read_opencode_live_tool_result_page(&path, "root", None, None, &|| false).unwrap();
+    assert_eq!(page.results.len(), 17);
+    let cursor = serde_json::to_value(&page.cursor).unwrap();
+    assert_eq!(cursor["live"]["contexts"].as_array().unwrap().len(), 16);
+    assert_eq!(cursor["live"]["next_context"], 17);
+    assert_eq!(cursor["live"]["parts"]["part-0"]["context"], 0);
+    assert_eq!(cursor["live"]["contexts"][0][0], 1);
+    let mut statement = connection.prepare("SELECT id,seq,type,data FROM event ORDER BY seq").unwrap();
+    let events = statement.query_map([], |row| Ok(json!({"id":row.get::<_,String>(0)?,
+        "seq":row.get::<_,u64>(1)?,"type":row.get::<_,String>(2)?,
+        "data":serde_json::from_str::<Value>(&row.get::<_,String>(3)?).unwrap()}))).unwrap()
+        .collect::<rusqlite::Result<Vec<_>>>().unwrap();
+    let mut evicted_correction = delivery_result(0);
+    evicted_correction["part"]["state"]["error"] = json!("synthetic corrected evicted result");
+    let mut retained_correction = delivery_result(16);
+    retained_correction["part"]["state"]["error"] = json!("synthetic corrected retained result");
+    let continuation_events = [evicted_correction, retained_correction, request_text(17), delivery_result(17)]
+        .into_iter().enumerate().map(|(index, data)| {
+            let sequence = 39 + index as i64;
+            insert_journal_event(&connection, sequence, "message.part.updated.1", data.clone());
+            json!({"id":format!("event-{sequence}"),"seq":sequence,"type":"message.part.updated.1","data":data})
+        }).collect::<Vec<_>>();
+    let continued = read_opencode_live_tool_result_page(&path, "root", Some(&page.cursor), None, &|| false).unwrap();
+    assert_eq!(continued.results.len(), 3);
+    assert!(continued.results[0].context.as_ref().unwrap().user_messages.is_empty());
+    let fixture = json!({"parser_revision":64,"cursor":cursor,"events":events,
+        "completed":page.results,"continuation_events":continuation_events,
+        "continued":continued.results});
+    let output = std::path::PathBuf::from(std::env::var("ANTIBURN_RECEIPT_FIXTURE_OUTPUT").unwrap());
+    std::fs::write(output.join("journal-v1-evicted-context.json"), serde_json::to_vec_pretty(&fixture).unwrap()).unwrap();
+}
