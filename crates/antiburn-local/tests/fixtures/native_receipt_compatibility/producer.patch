+fn fixture_digest(value: &Value) -> String {
+    use sha2::Digest;
+    sha2::Sha256::digest(serde_json::to_vec(value).unwrap()).iter()
+        .map(|byte| format!("{byte:02x}")).collect()
+}
+
+fn sparse_fixture(value: &mut Value) {
+    match value {
+        Value::Array(items) if items.len() >= 1024 && items.iter().all(|item| item.as_u64().is_some()) => {
+            let nonzero = items.iter().enumerate().filter(|(_, item)| item.as_u64() != Some(0))
+                .map(|(index, item)| serde_json::json!([index, item])).collect::<Vec<_>>();
+            *value = serde_json::json!({"fixture_sparse_u64_array":{"len":items.len(),"nonzero":nonzero}});
+        }
+        Value::Array(items) => items.iter_mut().for_each(sparse_fixture),
+        Value::Object(fields) => fields.values_mut().for_each(sparse_fixture),
+        _ => {}
+    }
+}
