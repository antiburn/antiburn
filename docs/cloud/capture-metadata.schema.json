{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native capture metadata",
  "description": "Common version 1 metadata for JSONL and SQLite native captures. This schema checks structure, not UTF-8 byte budgets, digest bindings, native proof, source truth, permissions, or privacy. Fingerprint verification needs lossless producer number text. Sort decoded object keys by UTF-8 bytes, not default UTF-16 string order.",
  "type": "object",
  "required": [
    "version",
    "agent",
    "source_format",
    "native_session_id",
    "native_agent_id",
    "source_agent_version",
    "version_observations",
    "version_scan_complete",
    "owned_version_complete",
    "relationship",
    "history_completeness",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "agent": {
      "type": "string",
      "enum": ["claude-code", "codex", "cursor", "opencode", "pi"]
    },
    "source_format": {
      "type": "string",
      "enum": ["ClaudeJsonl", "CodexJsonl", "CursorCliAgentJsonl", "CursorIdeComposer", "OpenCodeSqliteV2", "PiJsonl"]
    },
    "native_session_id": {
      "type": "string",
      "minLength": 1
    },
    "native_agent_id": {
      "anyOf": [{ "$ref": "#/$defs/safeId" }, { "type": "null" }]
    },
    "source_agent_version": {
      "anyOf": [{ "$ref": "#/$defs/runtimeVersion" }, { "type": "null" }],
      "description": "Runtime version proved by owned native records, or null. The installed runtime and metadata producer version do not establish this value."
    },
    "version_observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/versionObservation" }
    },
    "version_scan_complete": {
      "type": "boolean"
    },
    "owned_version_complete": {
      "type": "boolean"
    },
    "relationship": {
      "$ref": "#/$defs/relationship"
    },
    "history_completeness": {
      "type": "string",
      "const": "unknown"
    },
    "sections": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": { "$ref": "#/$defs/sectionName" },
      "additionalProperties": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    },
    "dottedId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?![\\s\\S])"
    },
    "sectionName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+(?![\\s\\S])"
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "versionObservation": {
      "type": "object",
      "required": ["version", "ownership"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/runtimeVersion" },
        "ownership": {
          "type": "string",
          "enum": ["owned", "inherited", "unknown"]
        }
      }
    },
    "relationship": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "unknown" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "parent_source_id", "proof"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["child", "fork"] },
            "parent_source_id": { "type": "string", "minLength": 1 },
            "proof": { "$ref": "#/$defs/safeId" }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "required": ["schema", "producer", "observation", "evidence", "data"],
      "additionalProperties": true,
      "properties": {
        "schema": { "$ref": "#/$defs/dottedId" },
        "producer": { "$ref": "#/$defs/producer" },
        "observation": {
          "oneOf": [
            { "$ref": "#/$defs/sourcePosition" },
            { "$ref": "#/$defs/observedAt" }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/nativeStream" },
              { "$ref": "#/$defs/localObservation" }
            ]
          }
        },
        "data": {
          "description": "Any JSON value, including an object, array, string, number, boolean, or null. Preserve producer number text for digest verification. Prefer decimal strings for exact amounts under the producer's namespaced data contract."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "observation": {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "source_position" } }
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "type": "array",
                "contains": { "$ref": "#/$defs/nativeStream" }
              }
            }
          },
          "else": {
            "properties": {
              "evidence": {
                "type": "array",
                "contains": { "$ref": "#/$defs/localObservation" }
              }
            }
          }
        }
      ]
    },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true,
      "properties": {
        "name": { "$ref": "#/$defs/safeId" },
        "version": { "$ref": "#/$defs/dottedId" }
      }
    },
    "sourcePosition": {
      "type": "object",
      "required": ["kind", "stream_id", "expanded_offset"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "source_position" },
        "stream_id": { "$ref": "#/$defs/safeId" },
        "expanded_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "observedAt": {
      "type": "object",
      "required": ["kind", "unix_millis"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "observed_at" },
        "unix_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 253402300799999
        }
      }
    },
    "nativeStream": {
      "type": "object",
      "required": ["kind", "stream_id", "expanded_sha256"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "native_stream" },
        "stream_id": { "$ref": "#/$defs/safeId" },
        "expanded_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "localObservation": {
      "type": "object",
      "required": ["kind", "method", "data_sha256"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "local_observation" },
        "method": { "$ref": "#/$defs/safeId" },
        "data_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
