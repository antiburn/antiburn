# Optional. These values only enable Antigravity usage refresh in development.
# Get both values from a current official Antigravity 2.0 IDE or agy install.
# On macOS, inspect the installed client without reading account token stores:
# strings "/Applications/Antigravity.app/Contents/Resources/bin/language_server" | rg 'apps\.googleusercontent\.com|GOCSPX-'
# See CONTRIBUTING.md for Linux, Windows, and independent verification guidance.
GOOGLE_ANTIGRAVITY_2_IDE_AGY_OAUTH_CLIENT_ID=
GOOGLE_ANTIGRAVITY_2_IDE_AGY_OAUTH_CLIENT_SECRET=
