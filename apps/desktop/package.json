{
  "name": "@antiburn/desktop",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "antiburn desktop application for local coding-agent session analysis.",
  "scripts": {
    "dev": "node scripts/run-tauri.mjs dev --config src-tauri/tauri.debug.conf.json",
    "dev:bundle": "node scripts/run-tauri.mjs build --debug --config src-tauri/tauri.debug.conf.json",
    "dev:cli": "node scripts/run-tauri.mjs dev --with-cli --config src-tauri/tauri.debug.conf.json",
    "dev:bundle:cli": "node scripts/run-tauri.mjs build --debug --with-cli --config src-tauri/tauri.debug.conf.json",
    "dev:web": "vite",
    "build": "node ../../scripts/assemble-agent-integrations.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc --build --force",
    "test": "vitest run && node --test scripts/run-tauri.test.mjs scripts/cli-dev.test.mjs",
    "test:watch": "vitest",
    "test:visual": "node scripts/test-interface-scale.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "knip": "knip --no-progress",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bitcount-prop-single": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-virtual": "3.14.23",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/logos": "1.2.18",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  }
}
