{
  "name": "@antiburn/desktop",
  "version": "0.1.0-rc.7",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "description": "antiburn desktop application: menu-bar/tray shell over the local antiburn engine.",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.debug.conf.json",
    "dev:bundle": "tauri build --debug --config src-tauri/tauri.debug.conf.json",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "knip": "knip --no-progress",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/bitcount-prop-single": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-updater": "2.10.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/logos": "1.2.13",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
