{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "antiburn",
  "mainBinaryName": "antiburn",
  "version": "0.1.0-rc.1",
  "identifier": "ai.antiburn.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first visibility into your AI coding-agent sessions.",
    "longDescription": "antiburn discovers the coding-agent sessions already on your machine, analyzes the transcripts locally, and shows activity, session analytics, and API-equivalent cost estimates. Everything runs on your device.",
    "copyright": "antiburn contributors",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/antiburn/antiburn/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNjFDODg5MTQ1OTVBNjgKUldSb1dsa1VpY2hoZ3NYYXREYVNnYlVjK1FXTVRRMGlucTRpOW5ZWHZZdWp0ZU5TbE11aVdpOEIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
