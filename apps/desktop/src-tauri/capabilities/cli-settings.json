{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "cli-settings",
  "description": "Only Settings may inspect, test, repair, or copy the location of the internal CLI runtime.",
  "windows": ["settings"],
  "permissions": [
    "allow-get-cli-install-state",
    "allow-test-cli-installation",
    "clipboard-manager:allow-write-text",
    "allow-repair-cli-installation"
  ]
}
