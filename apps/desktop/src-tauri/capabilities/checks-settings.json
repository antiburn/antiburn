{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "checks-settings",
  "description": "Only Settings may change the TypeSafe credential.",
  "windows": ["settings"],
  "permissions": [
    "allow-set-typesafe-api-key",
    "allow-remove-typesafe-api-key",
    "allow-set-check-history-days",
    "allow-set-smart-burn-checks-enabled",
    "allow-run-check-backfill"
  ]
}
