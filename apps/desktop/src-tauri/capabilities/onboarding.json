{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "onboarding",
  "description": "Allow onboarding to read presentation settings, save local progress, and open the Cloud waitlist.",
  "windows": ["onboarding"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-get-settings",
    "allow-app-info",
    "allow-set-interface-scale",
    "allow-get-onboarding-state",
    "allow-set-onboarding-state",
    "allow-get-onboarding-window-visible",
    "allow-note-interaction",
    "allow-window-ready",
    "allow-hud-island-available",
    "dialog:allow-open",
    "allow-get-agent-integrations",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://antiburn.com/cloud" }]
    }
  ]
}
