{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "cloud-account",
  "description": "Only account and onboarding surfaces may inspect or disconnect the Cloud account.",
  "windows": ["main", "settings", "onboarding"],
  "permissions": [
    "allow-cloud-status",
    "allow-cloud-begin",
    "allow-cloud-cancel",
    "allow-cloud-sign-out",
    "allow-cloud-save-draft",
    "allow-cloud-start-sync"
  ]
}
