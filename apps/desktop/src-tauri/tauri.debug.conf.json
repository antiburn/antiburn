{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "ai.antiburn.desktop.debug",
  "app": {
    "security": {
      "capabilities": [
        "default",
        "main-window",
        "onboarding",
        "popover-peek",
        "popover-peek-anchor",
        "checks-remediation",
        "checks-settings",
        "cli-settings",
        "agent-integrations-settings",
        "cloud-account",
        "cloud-dev"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ai-antiburn-desktop-debug"]
      }
    }
  }
}
